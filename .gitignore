# ============================================================
# Asset Forge — что НЕ попадает в репозиторий
# Правило: в git живут исходники и рецепты, не продукты и веса
# ============================================================

# --- Веса моделей и обученные сети (пересоздаются/в backup) ---
*.safetensors
*.ckpt
*.pth
*.onnx
*.bin
*.pt

# --- Рабочие артефакты конвейера (генерятся, не хранятся) ---
work/
assets/
manifest.csv
mode.txt

# --- Обучение и его выходы ---
lora_output/
lora_check/
lora_check_kohya/

# --- Сырьё датасета (отобранное — в lora_dataset, оно коммитится) ---
lora_dataset_raw/

# --- Веса LoRA (хранятся в backup; при необходимости — релизы GitHub) ---
loras/

# --- Сгенерированные тестовые сетки ---
grid.png

# --- Прочее из ML-стека ---
*.egg-info/
.huggingface/

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# --- C++ сборка ---
*.obj
*.pdb
*.ilk
*.exp
*.lib

# --- Системное ---
Thumbs.db
desktop.ini
 $RECYCLE.BIN/

# --- Редакторы ---
.vscode/
.idea/